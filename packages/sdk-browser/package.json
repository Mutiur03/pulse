{
  "name": "@pulse/browser",
  "version": "0.1.0",
  "description": "Browser SDK for Pulse: product events, errors, web vitals and OpenTelemetry traces",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "size": "node scripts/size.mjs"
  },
  "keywords": [
    "analytics",
    "observability",
    "opentelemetry"
  ],
  "license": "MIT",
  "devDependencies": {
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "esbuild": "^0.24.2",
    "jsdom": "^25.0.1",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.12.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/instrumentation": "^0.223.0",
    "@opentelemetry/instrumentation-document-load": "^0.68.0",
    "@opentelemetry/instrumentation-fetch": "^0.223.0",
    "@opentelemetry/instrumentation-user-interaction": "^0.67.0",
    "@opentelemetry/instrumentation-xml-http-request": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-web": "^2.12.0",
    "web-vitals": "^6.2.3"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false
}
